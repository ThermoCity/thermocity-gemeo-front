# Copie para .env.local e ajuste. O .env.local não vai para o Git.

# API da base territorial (setores, calor, IPVS, população idosa, UBS e refúgios), publicada no Azure
VITE_API_TERRITORIO_URL=https://thermocity-base-territorial-api.azurewebsites.net
# true = usa os setores e serviços de public/mocks em vez da API (uso offline)
VITE_USE_MOCKS_TERRITORIO=false

# true = usa dados mockados para o que ainda não tem API: usuário, nível de calor, estado e lista do dia
VITE_USE_MOCKS=true

# API Java de cadastro (Arthur): lista do dia (GET /listas/hoje), contatos e cobertura
VITE_API_JAVA_URL=http://localhost:8081
# false = lista do dia real da API de cadastro (precisa do token de um GESTOR abaixo); padrão: segue VITE_USE_MOCKS
VITE_USE_MOCKS_LISTA=true
# Token JWT de um gestor, copiado do login da API de cadastro (POST /auth/login no Swagger). Vale 2 h. Não vai para o Git.
VITE_DEV_TOKEN=

# API de clima (.NET): nível de calor atual e previsto
VITE_API_CLIMA_URL=http://localhost:5000

# Tempo máximo de cada requisição (ms). No Azure, a primeira chamada depois de um tempo parado demora mais.
VITE_API_TIMEOUT_MS=90000
