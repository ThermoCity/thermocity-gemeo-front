# Copie para .env.local e ajuste. O .env.local não vai para o Git.

# true = usa os dados mockados de src/mocks (padrão enquanto as APIs não estão prontas)
VITE_USE_MOCKS=true

# API Java (base-territorial / gêmeo): setores, lista do dia, contatos, simulações
VITE_API_JAVA_URL=http://localhost:8080

# API de clima (.NET): nível de calor atual e previsto
VITE_API_CLIMA_URL=http://localhost:5000

# Token JWT de um usuário GESTOR, usado enquanto não existe tela de login
VITE_DEV_TOKEN=

# Tempo máximo de cada requisição (ms)
VITE_API_TIMEOUT_MS=10000
